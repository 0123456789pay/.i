{
  "version": "1.0.0",
  "name": "ConfigProtokol Digital Master Configuration",
  "description": "Master configuration for secure browser protocol management",
  "github_repo": "https://github.com/configprotokol/digital",
  "protocols": {
    "https_tls": {
      "enabled": true,
      "min_version": "TLSv1.3",
      "cipher_suites": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256",
        "TLS_AES_128_GCM_SHA256"
      ],
      "certificate_transparency": true,
      "ocsp_stapling": true
    },
    "hsts": {
      "enabled": true,
      "max_age": 31536000,
      "include_subdomains": true,
      "preload": true
    },
    "csp": {
      "enabled": true,
      "policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
      "report_uri": "/csp-report",
      "report_to": "csp-endpoint"
    },
    "http2": {
      "enabled": true,
      "multiplexing": true,
      "server_push": false,
      "max_concurrent_streams": 100
    },
    "http3": {
      "enabled": true,
      "quic_version": "draft-29",
      "alt_svc": true
    },
    "webauthn": {
      "enabled": true,
      "authenticator_attachment": "platform",
      "user_verification": "required",
      "resident_key": "preferred"
    },
    "doh_dot": {
      "enabled": true,
      "doh_endpoint": "https://cloudflare-dns.com/dns-query",
      "dot_endpoint": "1.1.1.1:853",
      "fallback": false
    }
  },
  "security_headers": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Cross-Origin-Embedder-Policy": "require-corp",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-site"
  },
  "browser_compatibility": {
    "chrome": {
      "min_version": 90,
      "flags": ["--enable-features=SecureDNS"]
    },
    "firefox": {
      "min_version": 88,
      "about_config": {
        "network.security.esni.enabled": true,
        "privacy.doh.mode": 2
      }
    },
    "safari": {
      "min_version": 14,
      "features": ["ITP", "Privacy Report"]
    },
    "edge": {
      "min_version": 90,
      "flags": ["#enable-parallel-downloading"]
    }
  },
  "update_settings": {
    "auto_update": true,
    "check_interval": 3600,
    "github_sync": true,
    "backup_before_update": true
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "format": "json",
    "output": "/var/log/configprotokol.log"
  }
}
