{
  "name": "pusat-system",
  "version": "1.0.0",
  "description": "Pusat Utama Sistem Terintegrasi - Central Hub for File Management, AI Studio, Hosting, Domain, and Monitoring",
  "main": "index.html",
  "author": "PUSAT Team",
  "license": "MIT",
  "config": {
    "siteName": "PUSAT System",
    "language": "id",
    "theme": "light",
    "defaultFolder": "/workspace",
    "autoRefresh": true,
    "showHiddenFiles": false,
    "aiModel": "gpt-4",
    "aiContextLength": 4000
  },
  "features": {
    "datacenter": {
      "enabled": true,
      "description": "Server and database management dashboard",
      "components": ["server-status", "database-info", "network-stats", "file-overview"]
    },
    "filemanager": {
      "enabled": true,
      "description": "File management system with CRUD operations",
      "components": ["file-browser", "toolbar", "search"]
    },
    "filenavigator": {
      "enabled": true,
      "description": "Hierarchical file system navigation",
      "components": ["breadcrumb", "tree-view"]
    },
    "studio-ai": {
      "enabled": true,
      "description": "AI-powered code assistant and analyzer",
      "components": ["chat-panel", "code-suggestions"]
    },
    "hosting": {
      "enabled": true,
      "description": "Hosting and deployment management",
      "components": ["hosting-plan", "deployment-status", "quick-deploy"]
    },
    "domain": {
      "enabled": true,
      "description": "Domain and DNS configuration",
      "components": ["domain-list", "dns-settings"]
    },
    "configuration": {
      "enabled": true,
      "description": "System settings and preferences",
      "components": ["general-settings", "file-system", "ai-settings"]
    },
    "status-monitoring": {
      "enabled": true,
      "description": "Real-time system health and performance monitoring",
      "components": ["system-health", "performance-metrics", "activity-log", "resource-chart"]
    }
  },
  "fileTypes": {
    "supported": ["js", "css", "html", "json", "md", "py", "sql", "php"],
    "icons": {
      "js": "📄",
      "css": "🎨",
      "html": "🌐",
      "json": "⚙️",
      "md": "📝",
      "py": "🐍",
      "sql": "🗄️",
      "folder": "📁"
    }
  },
  "statistics": {
    "totalFiles": 4800,
    "jsFiles": 2500,
    "cssFiles": 1500,
    "htmlFiles": 100,
    "folders": 50
  },
  "endpoints": {
    "api": "/api/v1",
    "files": "/api/v1/files",
    "config": "/api/v1/config",
    "ai": "/api/v1/ai",
    "monitoring": "/api/v1/monitoring"
  },
  "dependencies": {},
  "scripts": {
    "start": "open index.html",
    "dev": "echo 'Development mode - open index.html in browser'",
    "build": "echo 'Production build complete'"
  }
}
