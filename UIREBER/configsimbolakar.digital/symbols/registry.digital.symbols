# USAGE IN HTML
# -------------

<!-- Using Unicode -->
<span>&#8730;</span>

<!-- Using HTML Entity -->
<span>&radic;</span>

<!-- Using Direct Character -->
<span>√</span>

# USAGE IN CSS
# ------------

.symbol::before {
    content: "\\221A";
}

.symbol::after {
    content: "√";
}

