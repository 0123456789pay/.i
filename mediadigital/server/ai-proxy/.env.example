# Example environment variables for AI proxy server
# Copy this file to .env and fill secrets. DO NOT commit .env to git.

# Server
PORT=8080
# Admin secret header required for /api/admin/* endpoints
ADMIN_SECRET=please_change_to_a_strong_secret

# Providers (only fill the providers you will use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
LOCAL_AI_ENDPOINT=

# Optional: persistence (Redis) for production
# REDIS_URL=redis://:password@redis-host:6379/0

# Notes:
# - OPENAI_API_KEY: set if you use OpenAI provider.
# - AZURE_OPENAI_ENDPOINT: full base endpoint, e.g. https://your-resource.openai.azure.com
# - LOCAL_AI_ENDPOINT: e.g. http://127.0.0.1:8081 if you run a local LLM server
# - ADMIN_SECRET: required to call admin endpoints; keep it secret and strong.
